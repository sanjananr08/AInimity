# AInimity environment configuration
# Copy this file to .env, then replace every PASTE_* placeholder.
# Never commit .env or paste server secrets into frontend files.

# -----------------------------------------------------------------------------
# Supabase authentication and private file storage
# Get these from Supabase Project Settings -> API.
# Use the browser-safe publishable key (or legacy anon key), NOT service_role.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://yewstzwqdljvichqrugv.supabase.co
SUPABASE_KEY=sb_publishable_bdjKdbPNOyn_SFdRU-UeoQ_DNW9Y1BT
SUPABASE_SERVICE_KEY=your-secret-key
# Optional legacy alias; use this only if SUPABASE_PUBLISHABLE_KEY is empty.
# SUPABASE_ANON_KEY=PASTE_YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_STORAGE_BUCKET=council-documents
SUPABASE_MAX_FILE_SIZE_BYTES=20971520
# Empty allows the configured Supabase bucket policy to decide accepted types.
# Example: image/png,image/jpeg,application/pdf,text/plain
SUPABASE_ALLOWED_MIME_TYPES=
SUPABASE_EMAIL_CONFIRMATION_REQUIRED=true

# -----------------------------------------------------------------------------
# Gemini / Google AI
# One shared key is enough for local use. Dedicated role keys are optional.
# Dedicated keys override GEMINI_API_KEY for their matching role.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
# Optional alias for the shared key.
# GEMINI_SHARED_API_KEY=PASTE_YOUR_SHARED_GEMINI_API_KEY_HERE
# Optional dedicated keys for the five council roles.
# GEMINI_API_KEY_STRATEGIST=PASTE_STRATEGIST_KEY_HERE
# GEMINI_API_KEY_TECHNICAL=PASTE_TECHNICAL_KEY_HERE
# GEMINI_API_KEY_ADVERSARIAL=PASTE_ADVERSARIAL_KEY_HERE
# GEMINI_API_KEY_HUMAN_MIND=PASTE_HUMAN_MIND_KEY_HERE
# GEMINI_API_KEY_VALIDATOR=PASTE_VALIDATOR_KEY_HERE

# Use a model enabled for your Google AI project.
GEMINI_MODEL=gemini-3.8-flash
# Used once when a configured model is no longer available.
GEMINI_FALLBACK_MODEL=gemini-3.8-flash
# Optional per-role model overrides.
# GEMINI_MODEL_STRATEGIST=gemini-3.8-flash
# GEMINI_MODEL_TECHNICAL=gemini-3.8-flash
# GEMINI_MODEL_ADVERSARIAL=gemini-3.8-flash
# GEMINI_MODEL_HUMAN_MIND=gemini-3.8-flash
# GEMINI_MODEL_VALIDATOR=gemini-3.8-flash
# Local calls per minute per role; lower this if your project has a smaller quota.
GEMINI_RPM_LIMIT=4

# -----------------------------------------------------------------------------
# Application and browser behavior
# -----------------------------------------------------------------------------
APP_PORT=8000
# Hosting platforms usually provide PORT; it takes precedence over APP_PORT.
# PORT=8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
VOICE_RECOGNITION_LANGUAGE=en-IN
COUNCIL_DEADLINE=2026-12-31T23:59:00Z

# -----------------------------------------------------------------------------
# Local persistence and cookie behavior
# -----------------------------------------------------------------------------
AINIMITY_DB_PATH=data/ainimity.db
AINIMITY_SESSION_DAYS=7
# Set true only when serving over HTTPS.
AINIMITY_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# Optional Node.js / MongoDB outcome-learning adapter
# The main app does not require these values. Never commit a real URI.
# -----------------------------------------------------------------------------
# MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER/ainimity
MONGODB_DATABASE=ainimity
MONGODB_COLLECTION=decision_snapshots
